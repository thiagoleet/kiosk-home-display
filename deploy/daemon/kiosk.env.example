HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Must match the origin the browser loads the frontend from (host only, no scheme/port).
HTTP_ALLOWED_ORIGINS=localhost

# How the daemon powers the screen. Check which session the Pi runs with
# "echo $XDG_SESSION_TYPE" before choosing:
#   virtual - logs the transitions and touches no hardware
#   linux   - X11, through xset dpms (x11-xserver-utils)
#   wayland - labwc/wayfire, through wlopm, falling back to wlr-randr. This is
#             the default session on Raspberry Pi OS Bookworm and later, where
#             xset cannot reach the physical output. Install wlopm: the
#             fallback disables the output instead of powering it down, and
#             some compositors refuse to re-enable it.
# Either real mode needs the service user to own the desktop session, plus the
# session variables below.
DISPLAY_MODE=virtual
# With DISPLAY_MODE=linux this is a software gamma adjustment via xrandr, not a
# backlight change. 0 renders the screen black without powering it off. The
# wayland mode has no brightness control and ignores this.
DISPLAY_BRIGHTNESS=100

# Required only when DISPLAY_MODE=linux.
#DISPLAY=:0
#XAUTHORITY=/home/pi/.Xauthority

# Lets DISPLAY_MODE=wayland fall back to wlr-randr when wlopm is not installed.
# The fallback disables the output rather than powering it down, and some
# compositors refuse to re-enable it, which leaves the screen dark until the
# session restarts — on a timer, that repeats every IDLE_TIMEOUT. Install wlopm
# instead of setting this.
#WAYLAND_ALLOW_OUTPUT_DISABLE=false

# Optional with DISPLAY_MODE=wayland. A system service inherits no session
# variables, so the daemon derives both from the user it runs as: the runtime
# directory is /run/user/<uid> and the compositor socket is whatever
# "wayland-*" it finds inside. Set them only to override that, for instance
# when the compositor lives on another seat.
#XDG_RUNTIME_DIR=/run/user/1000
#WAYLAND_DISPLAY=wayland-0

# The idle timeout announces idleness so the frontend raises the screensaver,
# and the display is only powered down IDLE_SLEEP_DELAY later — the screensaver
# needs a lit screen to be seen. The countdown then keeps watching, so the
# screen also goes back to sleep after a notification wakes it. Nothing reports
# user activity yet, so with this enabled the display stays on for
# IDLE_TIMEOUT + IDLE_SLEEP_DELAY after each wake and no longer. Set
# IDLE_ENABLED=false to leave the screen on for the whole SCHEDULE_ON window,
# or IDLE_SLEEP_DELAY=0 to power the screen down as soon as it goes idle.
IDLE_ENABLED=true
IDLE_TIMEOUT=5m
IDLE_SLEEP_DELAY=5m

SCHEDULE_ENABLED=true
SCHEDULE_ON=07:00
SCHEDULE_OFF=23:00
TIMEZONE=America/Sao_Paulo

ACTIVITY_LIFE_SPAN=168h

# Where print jobs come from:
#   virtual - watches nothing, and POST /api/printer/print simulates a job so
#             the notification and activity paths can be exercised
#   cups    - polls the queue on this host with lpstat and lpq, and publishes a
#             printer event whenever a job enters or leaves it. Needs the
#             cups-client package; the daemon links against no CUPS library and
#             submits nothing, it only reads. Simulated jobs are refused in
#             this mode, since the next poll would contradict them.
# Jobs already queued when the daemon starts become the baseline and raise no
# notification, so a job stuck in the queue is not announced on every restart.
# CUPS reports no reason for a job leaving the queue, so a cancelled job is
# published as completed.
PRINTER_MODE=virtual
# How often the queue is read in cups mode. A job that starts and finishes
# inside one interval is never seen, so keep this well under the time your
# shortest print takes.
PRINTER_POLL_INTERVAL=5s

WEATHER_ENABLED=false
WEATHER_LATITUDE=-23.55052
WEATHER_LONGITUDE=-46.633308
WEATHER_TIMEZONE=America/Sao_Paulo
WEATHER_CACHE_TTL=5m
# How many days the daily outlook covers, today included. 1 to 16.
WEATHER_FORECAST_DAYS=5

OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
