# Frontend build settings for SNESPI.
#
# Sourced by deploy/frontend/build.sh before `pnpm build`. Vite inlines
# these at build time, so each box needs its own build — changing a value
# here means rebuilding and reinstalling the frontend on that box.

VITE_KIOSK_PROFILE=snespi

# Set to "off" to keep this box on the home screen and never raise the
# screensaver. The daemon still powers the panel down on its own idle
# schedule — see IDLE_ENABLED in kiosk.env next to this file.
VITE_SCREENSAVER=off
