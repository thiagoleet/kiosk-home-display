# Frontend build-time settings. Copy to .env.local and edit; Vite inlines these
# at build time, so a change only takes effect after `pnpm build` (or a `pnpm
# dev` restart).

# Override the WebSocket endpoint. Defaults to ws://localhost:8080/ws in dev and
# to the page's own origin in production (behind the nginx reverse proxy).
# VITE_WS_URL=ws://localhost:8080/ws

# Which box this build targets: snespi or milkpi. Decides the theme, the locale
# and which features the screen offers — snespi has no printer. An unset or
# unknown value falls back to milkpi. The deploy sets this from
# deploy/environments/<name>/frontend.env; set it here only for local work.
# VITE_KIOSK_PROFILE=milkpi

# Set to "off" to keep the kiosk on the home screen and never show the
# screensaver. Note this only suppresses the screensaver UI — the daemon still
# powers the panel down on its own idle schedule (see deploy/daemon/kiosk.env).
# VITE_SCREENSAVER=off
