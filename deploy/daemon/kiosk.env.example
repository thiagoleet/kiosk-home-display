HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Must match the origin the browser loads the frontend from (host only, no scheme/port).
HTTP_ALLOWED_ORIGINS=localhost

# How the daemon powers the screen. Check which session the Pi runs with
# "echo $XDG_SESSION_TYPE" before choosing:
#   virtual - logs the transitions and touches no hardware
#   linux   - X11, through xset dpms (x11-xserver-utils)
#   wayland - labwc/wayfire, through wlr-randr (wlr-randr package). This is the
#             default session on Raspberry Pi OS Bookworm and later, where xset
#             cannot reach the physical output.
# Either real mode needs the service user to own the desktop session, plus the
# session variables below.
DISPLAY_MODE=virtual
# With DISPLAY_MODE=linux this is a software gamma adjustment via xrandr, not a
# backlight change. 0 renders the screen black without powering it off. The
# wayland mode has no brightness control and ignores this.
DISPLAY_BRIGHTNESS=100

# Required only when DISPLAY_MODE=linux.
#DISPLAY=:0
#XAUTHORITY=/home/pi/.Xauthority

# Optional with DISPLAY_MODE=wayland. A system service inherits no session
# variables, so the daemon derives both from the user it runs as: the runtime
# directory is /run/user/<uid> and the compositor socket is whatever
# "wayland-*" it finds inside. Set them only to override that, for instance
# when the compositor lives on another seat.
#XDG_RUNTIME_DIR=/run/user/1000
#WAYLAND_DISPLAY=wayland-0

# The idle timeout sleeps the display and then keeps watching, so the screen
# also goes back to sleep after a notification wakes it. Nothing reports user
# activity yet, so with this enabled the display stays on for IDLE_TIMEOUT after
# each wake and no longer. Set IDLE_ENABLED=false to leave the screen on for the
# whole SCHEDULE_ON window.
IDLE_ENABLED=true
IDLE_TIMEOUT=5m

SCHEDULE_ENABLED=true
SCHEDULE_ON=07:00
SCHEDULE_OFF=23:00
TIMEZONE=America/Sao_Paulo

ACTIVITY_LIFE_SPAN=168h

WEATHER_ENABLED=false
WEATHER_LATITUDE=-23.55052
WEATHER_LONGITUDE=-46.633308
WEATHER_TIMEZONE=America/Sao_Paulo
WEATHER_CACHE_TTL=5m

OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
