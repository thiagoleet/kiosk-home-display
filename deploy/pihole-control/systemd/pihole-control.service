[Unit]
Description=Pi-hole Control
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
DynamicUser=yes
WorkingDirectory=/opt/pihole-control/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=80
EnvironmentFile=/etc/pihole-control/pihole-control.env
ExecStart=/opt/pihole-control/current/node server.js
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
